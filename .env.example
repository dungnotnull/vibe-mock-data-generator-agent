NODE_ENV=development

# Anthropic API Key (for domain detection only)
ANTHROPIC_API_KEY=

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.8
OLLAMA_CONCURRENCY=3

# Generation Defaults
DEFAULT_MARKET=vietnam
DEFAULT_LANGUAGE=vi
DEFAULT_SEED=42

# Database Connection (for direct seeding — optional)
# PostgreSQL:
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=myapp_test
# DB_USER=postgres
# DB_PASSWORD=password

# MySQL:
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=myapp_test
# DB_USER=root
# DB_PASSWORD=password

# SQLite:
# DB_TYPE=sqlite
# DB_NAME=./test.db

# MongoDB:
# DB_TYPE=mongodb
# DB_HOST=localhost
# DB_PORT=27017
# DB_NAME=myapp_test
# DB_USER=mongouser
# DB_PASSWORD=password
